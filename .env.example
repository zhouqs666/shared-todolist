# 复制本文件为 .env 并填入真实值
# 命令：cp .env.example .env
#
# 注意：V2（PWA + Supabase 直连）架构下，
#   - 前端不需要 .env（anon key 直接写在 public/js/supabase.js 里，公开安全）
#   - .env 只供 scripts/init-users.mjs 用（创建 Auth 用户需要 service_role 权限）
#   - 静态服务器 scripts/serve.mjs 只读 PORT

# ===== 服务 =====
PORT=3000

# ===== Supabase 配置 =====
# 在 Supabase Dashboard → Project Settings → API 获取
# URL 形如：https://xxxx.supabase.co
SUPABASE_URL=https://your-project.supabase.co

# service_role key（管理员权限，用于 scripts/init-users.mjs 创建用户）
# ⚠️ 这个 key 绝不能写入前端代码、不能 commit、不能告诉任何人
# 只在本文件（.env）里，且 .env 已被 .gitignore 排除
SUPABASE_KEY=your-service-role-key

# anon key（公开 key，仅供 scripts 探针测试用）
# 前端实际使用的 anon key 写在 public/js/supabase.js 里（设计上可公开）
SUPABASE_ANON_KEY=your-anon-key

# ===== Supabase Management API 个人访问令牌 =====
# 供 scripts/apply-sql.mjs 用（把 supabase/*.sql 幂等迁移应用到测试/生产项目，
# 告别 Dashboard 手工粘贴）。到 https://supabase.com/dashboard/account/tokens 生成，
# ⚠️ 必须用**作用域受限** PAT（sbp_fc_ 开头）：只勾两个项目的 Database Read + Write。
# 详细 setup 与安全设计见 scripts/apply-sql.mjs 文件头注释。
SUPABASE_ACCESS_TOKEN=sbp_your-scoped-access-token
