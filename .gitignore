# 依赖
node_modules/

# 环境变量（含密码 hash，不要提交）
.env
.env.local
.env.*.local

# 本地运行时数据
data/*.json
data/*.db

# 日志
*.log
npm-debug.log*

# 编辑器
.vscode/
.idea/
.trae/
.DS_Store

# 构建产物（如以后引入前端构建工具）
dist/
build/
.zcode/

# 临时探针脚本（PWA 重构验证用）
.probe/

# ===== Capacitor / Android 原生工程 =====
# 注意：android/ 源码工程本身会被提交（便于团队打包），
#       只忽略构建产物、本地签名、IDE 配置。
android/.gradle/
android/app/build/
android/build/
android/captures/
android/local.properties
android/app/release/
*.iml

# 签名密钥（绝对不能提交，泄露=APP 可被冒名发布）
*.keystore
*.jks
keystore.properties

# 工作区记忆（本机，不提交）
.workbuddy/

# 发布临时产物
.release-tmp/

# 临时调试探针（任何下划线开头的临时脚本；_lib-* 是发布脚本依赖的内部库，例外）
scripts/_*.mjs
!scripts/_lib-*.mjs

