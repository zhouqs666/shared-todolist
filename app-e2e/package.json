{
  "name": "app-e2e",
  "version": "1.0.0",
  "description": "APP 自动化测试（Appium + WebdriverIO）",
  "type": "module",
  "scripts": {
    "pretest": "node scripts/check-test-schema.mjs && node scripts/check-rls.mjs",
    "test": "wdio run ./wdio.conf.js",
    "test:local": "wdio run ./wdio.conf.js",
    "check:schema": "node scripts/check-test-schema.mjs",
    "check:rls": "node scripts/check-rls.mjs"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.117.1",
    "@wdio/allure-reporter": "^9.32.0",
    "@wdio/cli": "^9.32.0",
    "@wdio/local-runner": "^9.32.0",
    "@wdio/mocha-framework": "^9.32.0",
    "@wdio/spec-reporter": "^9.32.0",
    "allure-commandline": "^2.46.1",
    "dotenv": "^17.4.2",
    "webdriverio": "^9.0.0"
  }
}
