# 复制本文件为 .env.test 并填入「独立 Supabase 测试项目」的真实值：
#   cp .env.test.example .env.test
#
# 用途：阶段 2 E2E 测试连接独立测试库（物理隔离，绝不碰生产库，对齐铁律一）
# 取值：Supabase Dashboard → Project Settings → API
#
# E2E_SUPABASE_URL                测试项目 URL（前端 build 时注入 VITE_SUPABASE_URL）
# E2E_SUPABASE_ANON_KEY           测试项目 anon key（public，注入前端）
# E2E_SUPABASE_SERVICE_ROLE_KEY   测试项目 service_role key（secret，仅测试造数/清数，绝不进前端）
# E2E_TEST_EMAIL                  测试账号邮箱（由 npm run init:test-users 创建）
# E2E_TEST_PASSWORD               测试账号密码（init 脚本与测试用例共用）
#
# ⚠️ 铁律：**模板 / 文档 / 代码里一律写占位符，真实值只放 .env.test（已 gitignore）与 GitHub Secrets。**
#    这个文件曾经写着真实账号邮箱 + 真实密码，在 public 仓库里躺了一周（2026-09-08 → 09-15 才发现）——
#    等于把凭据贴在公网。删除文件是不够的：**必须同时把该密码改掉**（历史提交里仍有它）。

E2E_SUPABASE_URL=https://your-test-project.supabase.co
E2E_SUPABASE_ANON_KEY=your-test-anon-key
E2E_SUPABASE_SERVICE_ROLE_KEY=your-test-service-role-key
E2E_TEST_EMAIL=test-user@example.com
E2E_TEST_PASSWORD=your-test-password
