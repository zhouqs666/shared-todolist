# 复制本文件为 .env 并填入真实值
# 命令：cp .env.example .env

# ===== 服务 =====
# 监听端口（Render 会自动注入 PORT，本地默认 3000）
PORT=3000
# 运行环境：development | production
NODE_ENV=development
# Session 加密密钥（生产环境务必换成随机长字符串，可用 `openssl rand -hex 32` 生成）
SESSION_SECRET=change-me-to-a-long-random-string

# ===== 双账号配置（Q4 决策）=====
# 首次启动时若 users 表为空，会用这些值自动初始化两条账号
# 密码 hash 生成方式（在 Node 里执行）：
#   node --input-type=module -e "import bcrypt from 'bcryptjs'; console.log(bcrypt.hashSync('你的密码', 10))"
# 然后把输出（$2a$10$xxxx...）填到下面的 PASSWORD_HASH
#
# 下面两条 hash 对应明文均为 "password"，仅供本地开发快速跑通用。
# ⚠️ 生产环境务必改成你自己的密码 hash！
USER_A_USERNAME=alice
USER_A_DISPLAY_NAME=Alice
USER_A_PASSWORD_HASH=$2a$10$nEO5Zh9L58BlhtpYQ.nQKO35/C7Jb7bk8TSpgbxsPgZ/OedGAzRJK

USER_B_USERNAME=bob
USER_B_DISPLAY_NAME=Bob
USER_B_PASSWORD_HASH=$2a$10$cmWLfcxJ6TpBPJejfWy1dex99ebEBMlmb.gCTPm9bWB9abvArFN2m

# ===== 数据存储（Q1 决策：Supabase）=====
# DB_TYPE=json       → 本地开发，数据存 data/todos.json（零依赖）
# DB_TYPE=supabase   → 生产，数据存 Supabase PostgreSQL
DB_TYPE=json

# Supabase 配置（仅 DB_TYPE=supabase 时需要）
# 在 Supabase 项目 Settings → API / Database 获取
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_DB_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres
