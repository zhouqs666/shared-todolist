{
  "name": "shared-todolist",
  "version": "2.0.0",
  "description": "双人共享待办清单 PWA（直连 Supabase）",
  "type": "module",
  "scripts": {
    "start": "node scripts/serve.mjs",
    "dev": "node --watch scripts/serve.mjs",
    "init-users": "node scripts/init-users.mjs",
    "bundle:supabase": "esbuild --bundle --format=esm --platform=browser --target=es2020 --minify --outfile=public/js/vendor/supabase-js.esm.js @supabase/supabase-js"
  },
  "keywords": [
    "todolist",
    "shared",
    "realtime",
    "pwa",
    "supabase"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.110.7"
  },
  "devDependencies": {
    "esbuild": "^0.21.5",
    "sharp": "^0.33.0"
  },
  "optionalDependencies": {}
}
