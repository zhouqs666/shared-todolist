{
  "name": "shared-todolist",
  "version": "2.0.0",
  "description": "双人共享待办清单 PWA（直连 Supabase）",
  "type": "module",
  "scripts": {
    "start": "node scripts/serve.mjs",
    "dev": "node --watch scripts/serve.mjs",
    "serve:test": "node scripts/serve-test.mjs",
    "check:test-env": "node scripts/check-test-env.mjs",
    "reset:test-db": "node scripts/reset-test-db.mjs",
    "bundle:supabase": "esbuild --bundle --format=esm --platform=browser --target=es2020 --minify --outfile=public/js/vendor/supabase-js.esm.js @supabase/supabase-js",
    "cap:sync": "cap sync",
    "cap:open": "cap open android",
    "cap:add:android": "cap add android"
  },
  "keywords": [
    "todolist",
    "shared",
    "realtime",
    "pwa",
    "supabase"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.4.2",
    "@capacitor/local-notifications": "^8.2.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capgo/capacitor-updater": "^10.0.0",
    "@supabase/supabase-js": "^2.110.7"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/cli": "^8.4.2",
    "@playwright/test": "^1.62.1",
    "esbuild": "^0.21.5",
    "playwright": "^1.62.1",
    "sharp": "^0.35.4",
    "typescript": "^7.0.2"
  }
}
